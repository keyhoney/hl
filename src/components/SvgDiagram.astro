---
interface Props {
  type?: string;
  className?: string;
  caption?: string;
}

const {
  type,
  className = '',
  caption = '좌표평면 위에서 수식의 조건이 기하학적으로 어떻게 작동하는지 보여주는 직관 해석 다이어그램입니다.',
} = Astro.props;
---

{type && (
  <figure class:list={['border border-slate-200 bg-white rounded-xl p-4 my-4 shadow-xs', className]}>
    <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100 text-xs text-slate-500 font-medium">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"
          />
        </svg>
        기하학적 그래프 해석 다이어그램
      </span>
      <span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-[11px]">SVG 정밀 시각화</span>
    </div>

    <div class="flex justify-center items-center py-2 overflow-x-auto">
      {type === 'quartic-tangent' && (
        <svg viewBox="0 0 520 280" class="w-full max-w-[500px] h-auto select-none" aria-label="사차함수 변곡 접선 다이어그램">
          <defs>
            <pattern id="grid1" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f1f5f9" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="520" height="280" fill="url(#grid1)" rx="8" />

          <line x1="40" y1="210" x2="490" y2="210" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" />
          <line x1="160" y1="20" x2="160" y2="260" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" />
          <text x="480" y="225" font-size="12" fill="#64748b" font-weight="600">x</text>
          <text x="145" y="30" font-size="12" fill="#64748b" font-weight="600">y</text>

          <path
            d="M 60,30 C 120,130 160,140 200,140 C 240,140 280,180 340,180 C 400,180 430,70 470,30"
            fill="none"
            stroke="#2563eb"
            stroke-width="3"
          />
          <text x="475" y="45" font-size="13" fill="#2563eb" font-weight="bold">y = g(x)</text>

          <line x1="40" y1="140" x2="480" y2="140" stroke="#ef4444" stroke-width="2" stroke-dasharray="4 2" />
          <text x="400" y="130" font-size="12" fill="#ef4444" font-weight="bold">수평 변곡 접선 y = g(t)</text>

          <circle cx="200" cy="140" r="5" fill="#ef4444" />
          <text x="180" y="160" font-size="11" fill="#b91c1c" font-weight="600">삼중접점 (부호불변)</text>

          <circle cx="125" cy="140" r="5" fill="#e11d48" stroke="#ffffff" stroke-width="2" />
          <text x="70" y="125" font-size="11" fill="#e11d48" font-weight="600">비미분 꺾임점 (1개)</text>

          <line x1="200" y1="230" x2="340" y2="230" stroke="#059669" stroke-width="1.5" marker-end="url(#arrow)" />
          <line x1="340" y1="230" x2="385" y2="230" stroke="#059669" stroke-width="1.5" />
          <rect x="235" y="220" width="80" height="20" rx="4" fill="#ecfdf5" stroke="#a7f3d0" />
          <text x="245" y="234" font-size="10" fill="#047857" font-weight="bold">3 : 1 비율 관계</text>
        </svg>
      )}

      {type === 'cubic-derivative' && (
        <svg viewBox="0 0 520 280" class="w-full max-w-[500px] h-auto select-none" aria-label="삼차함수 구간별 결합 및 수평선 스캔 다이어그램">
          <defs>
            <pattern id="grid2" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f1f5f9" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="520" height="280" fill="url(#grid2)" rx="8" />

          <line x1="40" y1="230" x2="490" y2="230" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" />
          <line x1="140" y1="20" x2="140" y2="260" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="3 3" />

          <line x1="220" y1="20" x2="220" y2="260" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4 4" />
          <text x="210" y="272" font-size="11" fill="#475569" font-weight="bold">x = 1 (경계)</text>

          <path d="M 60,220 C 130,220 180,80 220,80" fill="none" stroke="#2563eb" stroke-width="3" />
          <text x="80" y="160" font-size="12" fill="#2563eb" font-weight="bold">y = f(x) (x &lt; 1)</text>

          <path d="M 220,80 C 260,80 300,50 460,30" fill="none" stroke="#059669" stroke-width="3" />
          <text x="320" y="55" font-size="12" fill="#059669" font-weight="bold">y = f(x+a)-b (x ≥ 1)</text>

          <circle cx="220" cy="80" r="5" fill="#4f46e5" stroke="#ffffff" stroke-width="2" />
          <text x="230" y="95" font-size="11" fill="#4f46e5" font-weight="bold">연속 접합점 (1, 3)</text>

          <line x1="40" y1="120" x2="480" y2="120" stroke="#dc2626" stroke-width="1.5" stroke-dasharray="3 3" />
          <text x="410" y="115" font-size="11" fill="#dc2626" font-weight="bold">스위핑 직선 y = t</text>
          <text x="280" y="140" font-size="11" fill="#64748b">교점 개수 h(t)=1 유지</text>
        </svg>
      )}

      {type === 'transcendental-integral' && (
        <svg viewBox="0 0 520 280" class="w-full max-w-[500px] h-auto select-none" aria-label="역함수 사각형 정적분 면적 분할 다이어그램">
          <defs>
            <pattern id="grid3" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#f1f5f9" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="520" height="280" fill="url(#grid3)" rx="8" />

          <line x1="80" y1="220" x2="460" y2="220" stroke="#94a3b8" stroke-width="1.5" />
          <line x1="80" y1="20" x2="80" y2="220" stroke="#94a3b8" stroke-width="1.5" />
          <text x="450" y="235" font-size="12" fill="#64748b" font-weight="600">x</text>
          <text x="65" y="30" font-size="12" fill="#64748b" font-weight="600">y</text>

          <rect x="80" y="70" width="260" height="150" fill="#f8fafc" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 2" />
          <text x="345" y="235" font-size="12" fill="#334155" font-weight="bold">x = 1</text>
          <text x="50" y="75" font-size="12" fill="#334155" font-weight="bold">y = β</text>

          <path d="M 80,220 Q 200,210 340,70" fill="none" stroke="#3b82f6" stroke-width="3" />
          <text x="310" y="55" font-size="12" fill="#3b82f6" font-weight="bold">y = g(x)</text>

          <path d="M 80,220 Q 200,210 340,70 L 340,220 Z" fill="#bfdbfe" fill-opacity="0.5" />
          <text x="210" y="180" font-size="13" fill="#1e40af" font-weight="bold">∫ g(x) dx (구하는 넓이)</text>

          <text x="130" y="110" font-size="12" fill="#047857" font-weight="bold">직사각형 넓이 (1 × β) - ∫ f(t)dt</text>
        </svg>
      )}
    </div>

    <figcaption class="text-xs text-slate-600 text-center mt-2 leading-relaxed font-normal">
      {caption}
    </figcaption>
  </figure>
)}
