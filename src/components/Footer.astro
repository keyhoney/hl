---
import Brand from './Brand.astro';

const contentLinks = [
  { label: '홈페이지', href: '/' },
  { label: '문항 검색 및 전체 목록', href: '/problems' },
  { label: 'RSS 피드', href: '/rss.xml' },
];

const policyLinks = [
  { label: '사이트 소개 및 철학', href: '/about' },
  { label: '개인정보처리방침', href: '/privacy' },
  { label: '오류 제보 및 문의', href: '/contact' },
];
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {/* Brand Col */}
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <Brand tone="dark" size="sm" />
        </div>
        <p class="text-xs text-slate-400 leading-relaxed max-w-md mb-4">
          수능 수학 4점 킬러 및 준킬러 문항에 대해 교과서적 정석 풀이, 시험장 실전 숏컷, 단계별 힌트를 아우르는 다각도 해법 교육 콘텐츠 플랫폼입니다.
        </p>
      </div>

      {/* Quick Nav Col */}
      <div>
        <h4 class="text-xs font-bold text-white tracking-wider uppercase mb-3">콘텐츠 바로가기</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          {contentLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Policy & Info Col */}
      <div>
        <h4 class="text-xs font-bold text-white tracking-wider uppercase mb-3">안내 및 정책</h4>
        <ul class="space-y-2 text-xs text-slate-400">
          {policyLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Legal & Copyright */}
    <div class="border-t border-slate-800 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 gap-3">
      <p>
        © {new Date().getFullYear()} HowLearn. 본 사이트의 해설 및 다각도 분석 콘텐츠는 교육적 목적으로 제작되었습니다.
      </p>
      <p class="text-slate-500">
        문제 출처: 한국교육과정평가원(KICE) 공공데이터 인용
      </p>
    </div>
  </div>
</footer>
