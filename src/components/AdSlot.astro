---
/**
 * Google AdSense 광고 슬롯.
 *
 * `.env`에 아래 값을 설정하면 실제 애드센스 광고 단위가 렌더링됩니다.
 *   PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
 *   PUBLIC_ADSENSE_SLOT=1234567890
 *
 * 값이 없으면(로컬 개발·리뷰 단계) 레이아웃 시프트를 막기 위한 예약 영역만
 * 렌더링하므로, 광고 코드를 넣기 전에도 지면 구성과 여백을 그대로 확인할 수 있습니다.
 * 애드센스 정책에 맞춰 광고임을 알리는 라벨을 함께 표시합니다.
 */
interface Props {
  /** 광고 단위 ID. 생략하면 PUBLIC_ADSENSE_SLOT 환경변수를 사용합니다. */
  slot?: string;
  /** 슬롯 상단 라벨 (예: "광고 · 다음 해법") */
  label?: string;
  class?: string;
}

const {
  slot = import.meta.env.PUBLIC_ADSENSE_SLOT,
  label = '광고',
  class: className = '',
} = Astro.props;

const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const isConfigured = Boolean(client && slot);
---

<div class:list={['my-8', className]} data-ad-slot>
  <div class="text-[10px] font-medium text-slate-400 tracking-wide mb-1.5">{label}</div>

  {isConfigured ? (
    <>
      <ins
        class="adsbygoogle block"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </>
  ) : (
    <div class="flex min-h-[100px] items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50/60 px-4 py-6 text-center text-[11px] leading-relaxed text-slate-400">
      광고 영역 (AdSense)
      <br />
      PUBLIC_ADSENSE_CLIENT · PUBLIC_ADSENSE_SLOT 설정 시 노출됩니다.
    </div>
  )}
</div>
