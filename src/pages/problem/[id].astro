---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import MdxContent from '../../components/MdxContent.astro';
import { getAdjacentProblems, getProblems } from '../../data/problems';
import type { Problem } from '../../types/mathProblem';
import { difficultyStars, getSubjectBadgeStyle } from '../../utils/mathHelpers';
import { orderSolutions, summarizeSolutionTypes } from '../../utils/solutions';

export async function getStaticPaths() {
  const problems = await getProblems();
  return problems.map((problem) => ({
    params: { id: problem.id },
    props: { problem },
  }));
}

interface Props {
  problem: Problem;
}

const { problem } = Astro.props;

const subjectStyle = getSubjectBadgeStyle(problem.subject);
const orderedSolutions = orderSolutions(problem.solutions);
const typeSummary = summarizeSolutionTypes(problem.solutions);
const solutionCount = problem.solutions.length;
const examLabel =
  problem.examType === '수능'
    ? `${problem.year}학년도 수능`
    : `${problem.year}학년도 ${problem.month}월 모평`;
const solutionLabel = solutionCount === 1 ? '상세 해설' : `${solutionCount}가지 해설`;
const pageTitle = `${examLabel} 수학 ${problem.problemNumber}번 단계별 힌트 및 ${solutionLabel}`;
const ogImage = `/og/${problem.id}.jpg`;
const ogImageAlt = `${examLabel} 수학 ${problem.problemNumber}번 문항 정보 · 난이도 ${problem.difficulty}/5 · 힌트 ${problem.hints.length}개 · 해설 ${solutionCount}개`;
const { previous, next } = await getAdjacentProblems(problem.id);
---

<BaseLayout
  title={pageTitle}
  description={`${examLabel} 수학 ${problem.problemNumber}번 문항의 ${problem.hints.length}개 단계별 힌트와 ${solutionLabel}을 확인하세요.`}
  ogType="article"
  ogImage={ogImage}
  ogImageType="image/jpeg"
  ogImageWidth={1200}
  ogImageHeight={1200}
  ogImageAlt={ogImageAlt}
  twitterCard="summary"
>
  <div class="space-y-8">
    {/* Breadcrumb */}
    <nav class="flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500 border-b border-slate-200 pb-3" aria-label="브레드크럼">
      <div class="flex items-center gap-1.5 flex-wrap">
        <a href="/" class="hover:text-indigo-600 transition-colors">홈</a>
        <span>/</span>
        <a href="/problems" class="hover:text-indigo-600 transition-colors">문항 목록</a>
        <span>/</span>
        <a href={`/problems?year=${problem.year}`} class="hover:text-indigo-600 transition-colors">{problem.year}학년도</a>
        <span>/</span>
        <span class="text-slate-800 font-bold">{problem.subject} {problem.problemNumber}번</span>
      </div>

      <a href="/problems" class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 font-semibold">
        ← 문항 목록으로 돌아가기
      </a>
    </nav>

    {/* Main Problem Header Card */}
    <header class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 text-xs font-bold rounded-lg bg-slate-900 text-white">
            {problem.examName}
          </span>
          <span class:list={['px-3 py-1 text-xs font-bold rounded-lg border', subjectStyle.bg, subjectStyle.text, subjectStyle.border]}>
            {problem.subject}
          </span>
          <span class="px-3 py-1 text-xs font-bold rounded-lg bg-amber-500 text-white shadow-xs">
            배점 {problem.points}점
          </span>
          <span
            class="px-3 py-1 text-xs font-bold rounded-lg border border-amber-200 bg-amber-50 text-amber-700 inline-flex items-center gap-1"
            title={`난이도 ${problem.difficulty} / 5`}
          >
            <span class="text-sm leading-none tracking-tighter text-amber-500" aria-hidden="true">
              {difficultyStars(problem.difficulty)}
            </span>
            <span class="sr-only">난이도 {problem.difficulty} / 5</span>
          </span>
          <span class="px-3 py-1 text-xs font-bold rounded-lg bg-slate-100 text-slate-700">
            {problem.answerType === 'mcq' ? '객관식' : '단답형'}
          </span>
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500">
          <span>출처: 한국교육과정평가원 (KICE) 기출</span>
          <a
            href="https://www.kice.re.kr"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 font-medium underline"
          >
            공식 원문 보기
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

      <div class="border-t border-slate-100 pt-4">
        <div class="text-xs font-semibold text-slate-500 mb-1">
          단원: {problem.unitName} &gt; {problem.subChapter} &gt; {problem.concept}
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          {problem.problemNumber}번 문항
        </h1>
      </div>

      {/* Problem Body (MDX → KaTeX) */}
      <div class="bg-white border border-slate-200 rounded-xl p-5 sm:p-6 text-slate-900 leading-relaxed text-sm sm:text-base">
        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          문제 원문
        </div>
        <MdxContent content={problem.problemBody} class="mdx-body" />
      </div>

      {/* Choices (객관식) */}
      {problem.choices.length > 0 && (
        <div class="border border-slate-200 rounded-xl p-5 sm:p-6 bg-white space-y-2">
          <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-3">보기</div>
          <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-2">
            {problem.choices.map((choice, index) => {
              const labels = ['①', '②', '③', '④', '⑤'];
              return (
                <li class="flex items-start gap-2.5 rounded-lg border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm sm:text-[15px] leading-relaxed text-slate-800">
                  <span class="shrink-0 font-bold text-slate-500">
                    {labels[index]}
                  </span>
                  <span class="flex-1">
                    <MdxContent content={choice} inline />
                  </span>
                </li>
              );
            })}
          </ol>
        </div>
      )}
    </header>

    {/* Hints Section — 단계별 힌트 전체 노출 */}
    {problem.hints.length > 0 && (
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs space-y-4">
        <div class="border-b border-slate-200 pb-4">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
            힌트 {problem.hints.length}단계
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            힌트를 순서대로 확인한 뒤 풀이로 넘어가세요.
          </p>
        </div>

        <div class="space-y-3">
          {problem.hints.map((hint, index) => (
            <div class="border border-slate-200 rounded-xl bg-slate-50/60 overflow-hidden">
              <div class="flex items-center gap-2 px-4 py-3 bg-slate-50 border-b border-slate-200/70">
                <span class="w-5 h-5 rounded-full bg-indigo-600 text-white text-[11px] flex items-center justify-center font-bold">
                  {index + 1}
                </span>
                <span class="text-sm font-bold text-slate-800">힌트 {index + 1}</span>
              </div>
              <div class="px-4 pb-4 pt-3 text-sm sm:text-[15px] text-slate-700 leading-relaxed bg-white">
                <MdxContent content={hint} />
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Solutions Section — 모든 해법을 순서대로 펼쳐 노출합니다 */}
    {orderedSolutions.length > 0 && (
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
              풀이 {problem.solutions.length}개
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">
              접근 방식별 장단점을 비교하고 최적의 시험장 전략을 수립하세요.
            </p>
            <div class="flex flex-wrap items-center gap-1.5 mt-2">
              {typeSummary.map((item) => (
                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-full">
                  <span class:list={['w-1.5 h-1.5 rounded-full', item.dotColor]} aria-hidden="true"></span>
                  {item.shortLabel} {item.count}가지
                </span>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-10">
          {orderedSolutions.map(({ solution: sol, displayLabel, dotColor }, index) => (
            <>
              {index > 0 && <AdSlot label="광고 · 다음 풀이" />}
              <article class="space-y-4 border-b border-slate-100 last:border-b-0 pb-8 last:pb-0">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200">
                  <div>
                    <span class="inline-flex items-center gap-1.5 text-xs font-extrabold text-indigo-700 bg-indigo-100 px-2.5 py-0.5 rounded">
                      <span class:list={['w-1.5 h-1.5 rounded-full', dotColor]} aria-hidden="true"></span>
                      {displayLabel}
                    </span>
                  </div>
                </div>

                <div class="mdx-body">
                  <MdxContent content={sol.content} />
                </div>
              </article>
            </>
          ))}
        </div>
      </section>
    )}

    {/* Related Problems — 같은 개념/단원의 다른 문항 */}
    {problem.related.length > 0 && (
      <section class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs space-y-4">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
          유사 기출 문항
        </h2>
        <p class="text-xs text-slate-500">
          이 문항과 동일한 개념을 다루는 다른 시험 문항입니다.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
          {problem.related.map((rel) => {
            const relSubjectStyle = getSubjectBadgeStyle(rel.subject);
            return (
              <a
                href={`/problem/${rel.id}`}
                class="group border border-slate-200 rounded-xl p-4 hover:border-indigo-400 hover:shadow-md transition-all bg-white flex flex-col justify-between gap-3"
              >
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                      <p class="text-[11px] font-semibold text-slate-400 line-clamp-1">
                        {rel.examName}
                      </p>
                      <h4 class="mt-0.5 flex items-baseline gap-1.5 text-base font-extrabold tracking-tight text-slate-900">
                        <span>{rel.year}학년도</span>
                        <span class="text-indigo-600">{rel.problemNumber}번</span>
                      </h4>
                    </div>
                    <span class:list={['shrink-0 text-[11px] font-semibold px-2 py-0.5 rounded-md border', relSubjectStyle.bg, relSubjectStyle.text, relSubjectStyle.border]}>
                      {rel.subject}
                    </span>
                  </div>

                  <p class="mt-2 text-xs font-medium text-slate-600 line-clamp-1">
                    {rel.unitName} · {rel.concept}
                  </p>

                  <div class="mt-3 flex flex-wrap items-center gap-1.5 text-[11px]">
                    <span
                      class="inline-flex items-center gap-0.5 rounded-md border border-amber-200 bg-amber-50 px-1.5 py-0.5"
                      title={`난이도 ${rel.difficulty} / 5`}
                    >
                      <span class="text-xs leading-none font-bold tracking-tighter text-amber-500" aria-hidden="true">
                        {difficultyStars(rel.difficulty)}
                      </span>
                      <span class="sr-only">난이도 {rel.difficulty} / 5</span>
                    </span>
                    <span class="rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-semibold text-slate-600">
                      {rel.points}점
                    </span>
                    <span class="rounded-md border border-indigo-100 bg-indigo-50 px-1.5 py-0.5 font-semibold text-indigo-700">
                      {rel.hintsCount}개 힌트
                    </span>
                    <span class="rounded-md border border-emerald-100 bg-emerald-50 px-1.5 py-0.5 font-semibold text-emerald-700">
                      {rel.solutionsCount}개 풀이
                    </span>
                  </div>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-2.5 text-[11px]">
                  <span class="min-w-0 truncate font-semibold text-slate-400">
                    {rel.answerType === 'mcq' ? '객관식' : '단답형'} · {rel.reason}
                  </span>
                  <span class="shrink-0 font-bold text-indigo-600 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-1">
                    문항 열기 →
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {/* Previous / Next navigation */}
    <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4" aria-label="이전·다음 문항">
      {previous ? (
        <a
          href={`/problem/${previous.id}`}
          class="border border-slate-200 rounded-xl bg-white p-4 hover:border-indigo-400 transition-colors"
        >
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">이전 문항</span>
          <span class="block text-sm font-bold text-slate-800 mt-0.5">
            {previous.year}학년도 {previous.subject} {previous.problemNumber}번
          </span>
        </a>
      ) : (
        <div />
      )}
      {next && (
        <a
          href={`/problem/${next.id}`}
          class="border border-slate-200 rounded-xl bg-white p-4 hover:border-indigo-400 transition-colors text-right"
        >
          <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">다음 문항</span>
          <span class="block text-sm font-bold text-slate-800 mt-0.5">
            {next.year}학년도 {next.subject} {next.problemNumber}번
          </span>
        </a>
      )}
    </nav>

    {/* Errata Report Prompt */}
    <section class="bg-slate-50 border border-slate-200 rounded-xl p-4 sm:p-5 flex items-center justify-end text-xs text-slate-500">
      <a
        href="/contact"
        class="text-xs font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 px-3 py-1.5 rounded-lg transition-colors inline-flex items-center gap-1"
      >
        <span>✍️</span>
        풀이 오류 및 오타 제보
      </a>
    </section>
  </div>
</BaseLayout>
