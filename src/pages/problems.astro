---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProblemCard from '../components/ProblemCard.astro';
import { getProblems } from '../data/problems';
import { getUniqueYears } from '../utils/filterProblems';
import { ALL_SUBJECTS } from '../utils/routes';

const PAGE = 12;

const problems = await getProblems();

const params = Astro.url.searchParams;
const initialQuery = params.get('q') ?? '';
const initialYear = params.get('year') ?? 'all';
const initialSubject = params.get('subject') ?? '전체';

const availableYears = getUniqueYears(problems);
const totalPages = Math.max(1, Math.ceil(problems.length / PAGE));

const hasActiveFilters =
  initialQuery !== '' || initialYear !== 'all' || initialSubject !== '전체';
---

<BaseLayout
  title="문항 검색·목록 | HowLearn"
  description="정석 풀이·스킬 숏컷·단계별 힌트가 등록된 수능 수학 4점 기출 문항을 학년도, 과목별로 검색하고 비교해 보세요."
>
  <div
    class="space-y-8"
    data-problem-list
    data-total={problems.length}
    data-page-size={PAGE}
    data-total-pages={totalPages}
  >
    {/* Page Header */}
    <div class="border-b border-slate-200 pb-5">
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        수능 수학 4점 문항 아카이브 &amp; 검색
      </h1>
      <p class="text-sm text-slate-500 mt-1">
        다각도 해법(정석 풀이·스킬 숏컷·단계별 힌트)이 등록된 4점 기출 문항을 검색하고 비교해 보세요.
      </p>
    </div>

    {/* Search & Filter Controls */}
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-xs space-y-4">
      {/* Search Input */}
      <div>
        <label for="search-input" class="block text-xs font-bold text-slate-700 mb-1.5">
          문항 검색 (시험명, 번호, 키워드, 개념, 해법 키워드)
        </label>
        <div class="relative">
          <input
            id="search-input"
            type="text"
            value={initialQuery}
            data-search-input
            placeholder="예: 22번, 삼중접선, 역함수 정적분, 사차함수, 미적분 I..."
            class="w-full px-4 py-2.5 pl-10 text-sm border border-slate-300 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-3 top-3 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button
            type="button"
            data-search-clear
            hidden={initialQuery === ''}
            class="absolute right-3 top-2.5 text-xs text-slate-400 hover:text-slate-600 p-1"
            aria-label="검색어 지우기"
          >
            ✕
          </button>
        </div>
      </div>

      {/* Filter Rows */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-slate-100">
        {/* Year Filter */}
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">학년도</label>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" class="filter-btn" data-filter="year" data-value="all" data-active={String(initialYear === 'all')}>
              전체
            </button>
            {availableYears.map((yr) => (
              <button type="button" class="filter-btn" data-filter="year" data-value={String(yr)} data-active={String(initialYear === String(yr))}>
                {yr}학년도
              </button>
            ))}
          </div>
        </div>

        {/* Subject Filter */}
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">과목</label>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" class="filter-btn" data-filter="subject" data-value="전체" data-active={String(initialSubject === '전체')}>
              전체
            </button>
            {ALL_SUBJECTS.map((subj) => (
              <button type="button" class="filter-btn" data-filter="subject" data-value={subj} data-active={String(initialSubject === subj)}>
                {subj}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Filter Summary & Reset Bar */}
      <div data-reset-bar hidden={!hasActiveFilters} class="flex items-center justify-between pt-2 border-t border-slate-100 text-xs">
        <span class="text-slate-500">필터가 적용되어 있습니다.</span>
        <button type="button" data-filter-reset class="text-xs font-bold text-rose-600 hover:text-rose-800 underline">
          모든 필터 초기화
        </button>
      </div>
    </div>

    {/* Results Header */}
    <div class="flex items-center justify-between text-xs font-medium text-slate-600 px-1">
      <span>
        검색 결과: <strong class="text-indigo-600 font-bold" data-result-count>{problems.length}</strong>개 문항
      </span>
      <span>정렬: 최근 학년도 순</span>
    </div>

    {/* Problem Cards Grid — initial HTML contains only the first page. */}
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      data-problem-grid
      aria-busy="false"
    >
      {problems.slice(0, PAGE).map((problem) => (
        <ProblemCard problem={problem} />
      ))}
    </div>

    {/* Empty State */}
    <div data-empty-state hidden class="bg-white border border-slate-200 rounded-xl p-12 text-center space-y-4">
      <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-slate-800">조건에 맞는 문항이 없습니다.</h3>
        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
          입력하신 검색어나 선택하신 필터 조건을 변경해 보시거나 필터를 초기화해 주세요.
        </p>
      </div>
      <button type="button" data-filter-reset class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition-colors">
        모든 필터 초기화하기
      </button>
    </div>

    {/* Pagination Bar (bottom, prominent) */}
    <div class="mt-10 flex flex-col items-center gap-3" data-pagination-bar>
      <div class="flex items-center gap-2 text-sm font-medium text-slate-700">
        <span data-page-info>
          페이지 <strong class="text-indigo-600 font-bold" data-current-page>1</strong> / <strong data-total-pages>{totalPages}</strong>
          · <span class="text-slate-400 font-normal">(1-{Math.min(PAGE, problems.length)} / {problems.length})</span>
        </span>
      </div>
      <div class="flex items-center gap-2" data-pagination-controls></div>
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-problem-list]');

  if (root) {
    const PAGE = Number(root.dataset.pageSize ?? '12') || 12;
    const TOTAL = Number(root.dataset.total ?? '0') || 0;
    const TOTAL_PAGES_ALL = Math.max(1, Number(root.dataset.totalPages ?? '1') || 1);

    const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-search-clear]');
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const resetButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter-reset]'));
    const resetBar = root.querySelector<HTMLElement>('[data-reset-bar]');
    const countEl = root.querySelector<HTMLElement>('[data-result-count]');
    const grid = root.querySelector<HTMLElement>('[data-problem-grid]');
    const emptyState = root.querySelector<HTMLElement>('[data-empty-state]');
    const pageInfo = root.querySelector<HTMLElement>('[data-page-info]');
    const curPageEl = root.querySelector<HTMLElement>('[data-current-page]');
    const totalPagesEl = root.querySelector<HTMLElement>('[data-total-pages]');
    const paginationControls = root.querySelector<HTMLElement>('[data-pagination-controls]');
    const paginationBar = root.querySelector<HTMLElement>('[data-pagination-bar]');

    const params = new URLSearchParams(window.location.search);
    const state: Record<string, string> = {
      q: params.get('q') ?? '',
      year: params.get('year') ?? 'all',
      subject: params.get('subject') ?? '전체',
      page: params.get('page') ?? '1',
    };

    let currentPage = Math.max(1, parseInt(state.page) || 1);
    let lastTotalPages = TOTAL_PAGES_ALL;
    let renderToken = 0;

    type IndexItem = { id: string; p: number; y: number; s: string; q: string };
    type IndexResponse = {
      total: number;
      pageSize: number;
      totalPages: number;
      items: IndexItem[];
    };
    type PageResponse = { cards: string[] };

    // 한 번에 너무 많은 카드 DOM을 메모리에 들고 있지 않도록 페이지 캐시를 제한합니다.
    const pageCache = new Map<number, HTMLElement[]>();
    const MAX_CACHED_PAGES = 10;
    const rememberPage = (page: number, nodes: HTMLElement[]) => {
      pageCache.set(page, nodes);
      while (pageCache.size > MAX_CACHED_PAGES) {
        for (const key of pageCache.keys()) {
          if (key === page) continue;
          pageCache.delete(key);
          break;
        }
      }
    };

    // 서버가 렌더링한 첫 페이지 카드는 다시 내려받지 않고 그대로 재사용합니다.
    const serverCards = Array.from(
      grid?.querySelectorAll<HTMLElement>('[data-problem-card]') ?? []
    );
    if (serverCards.length > 0) pageCache.set(1, serverCards);

    let indexPromise: Promise<IndexItem[]> | null = null;
    const loadIndex = (): Promise<IndexItem[]> => {
      if (!indexPromise) {
        indexPromise = fetch('/api/problems/index.json', {
          headers: { Accept: 'application/json' },
        })
          .then((response) => {
            if (!response.ok) throw new Error(`index: ${response.status}`);
            return response.json() as Promise<IndexResponse>;
          })
          .then((data) => data.items)
          .catch((error) => {
            indexPromise = null;
            throw error;
          });
      }
      return indexPromise;
    };

    const loadPage = async (page: number): Promise<HTMLElement[]> => {
      const cached = pageCache.get(page);
      if (cached) return cached;

      const response = await fetch(`/api/problems/${page}.json`, {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`page ${page}: ${response.status}`);

      const data = (await response.json()) as PageResponse;
      const template = document.createElement('template');
      template.innerHTML = data.cards.join('');
      const nodes = Array.from(
        template.content.querySelectorAll<HTMLElement>('[data-problem-card]')
      );
      rememberPage(page, nodes);
      return nodes;
    };

    const hasFilters = (): boolean =>
      state.q.trim() !== '' || state.year !== 'all' || state.subject !== '전체';

    const filterItems = (items: IndexItem[]): IndexItem[] => {
      const q = state.q.trim().toLowerCase();
      return items.filter((item) => {
        if (state.year !== 'all' && String(item.y) !== state.year) return false;
        if (state.subject !== '전체' && item.s !== state.subject) return false;
        if (q && !item.q.includes(q)) return false;
        return true;
      });
    };

    const syncUrl = () => {
      const next = new URLSearchParams();
      if (state.q) next.set('q', state.q);
      if (state.year !== 'all') next.set('year', state.year);
      if (state.subject !== '전체') next.set('subject', state.subject);
      if (currentPage > 1) next.set('page', String(currentPage));
      const query = next.toString();
      history.replaceState(
        null,
        '',
        query ? `${window.location.pathname}?${query}` : window.location.pathname
      );
    };

    const buildPagination = (totalPages: number) => {
      if (!paginationControls) return;
      paginationControls.innerHTML = '';

      const makeBtn = (
        label: string,
        onClick: () => void,
        disabled = false,
        active = false,
        big = false
      ) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `flex items-center justify-center rounded-xl font-bold transition-all shadow-sm ${
          big
            ? 'px-4 py-2.5 text-sm bg-indigo-600 text-white hover:bg-indigo-700 active:scale-95'
            : active
              ? 'px-3 py-2 text-sm bg-amber-400 text-slate-900 shadow-amber-200/50'
              : disabled
                ? 'px-3 py-2 text-sm bg-slate-100 text-slate-300 cursor-default'
                : 'px-3 py-2 text-sm bg-white border-2 border-slate-200 text-slate-700 hover:border-indigo-400 hover:text-indigo-700 active:scale-95'
        }`;
        btn.textContent = label;
        btn.disabled = disabled;
        btn.addEventListener('click', onClick);
        paginationControls.appendChild(btn);
      };

      makeBtn('◀◀ 처음', () => goPage(1), currentPage <= 1, false, true);
      makeBtn('◀ 이전', () => goPage(currentPage - 1), currentPage <= 1, false, false);
      for (let i = 1; i <= totalPages; i++) {
        if (
          totalPages <= 7 ||
          i === 1 ||
          i === totalPages ||
          (i >= currentPage - 1 && i <= currentPage + 1)
        ) {
          makeBtn(String(i), () => goPage(i), false, i === currentPage, false);
        } else if (i === currentPage - 2 || i === currentPage + 2) {
          const el = document.createElement('span');
          el.className = 'px-1.5 py-2 text-sm text-slate-400 font-bold select-none';
          el.textContent = '\u2026';
          paginationControls.appendChild(el);
        }
      }
      makeBtn('다음 ▶', () => goPage(currentPage + 1), currentPage >= totalPages, false, false);
      makeBtn('마지막 ▶▶', () => goPage(totalPages), currentPage >= totalPages, false, true);
    };

    const updateControls = (visibleCount: number) => {
      filterButtons.forEach((btn) => {
        btn.setAttribute(
          'data-active',
          String(state[btn.dataset.filter ?? ''] === btn.dataset.value)
        );
      });

      if (resetBar) resetBar.toggleAttribute('hidden', !hasFilters());
      if (clearBtn) clearBtn.toggleAttribute('hidden', state.q === '');
      if (searchInput && searchInput.value !== state.q) searchInput.value = state.q;

      if (pageInfo) {
        const start = visibleCount === 0 ? 0 : (currentPage - 1) * PAGE + 1;
        const end = Math.min(currentPage * PAGE, visibleCount);
        pageInfo.innerHTML = `페이지 <strong class="text-indigo-600 font-bold">${currentPage}</strong> / <strong>${lastTotalPages}</strong> · <span class="text-slate-400 font-normal">(${start}-${end} / ${visibleCount})</span>`;
      }
    };

    const render = async () => {
      const token = ++renderToken;
      if (grid) {
        grid.setAttribute('aria-busy', 'true');
        grid.classList.add('opacity-60');
      }

      try {
        let visibleCount: number;
        let cardsToShow: HTMLElement[];

        if (hasFilters()) {
          const items = await loadIndex();
          if (token !== renderToken) return;

          const matched = filterItems(items);
          visibleCount = matched.length;
          lastTotalPages = Math.max(1, Math.ceil(visibleCount / PAGE));
          currentPage = Math.max(1, Math.min(currentPage, lastTotalPages));

          const start = (currentPage - 1) * PAGE;
          const pageItems = matched.slice(start, start + PAGE);
          const neededPages = Array.from(new Set(pageItems.map((item) => item.p)));

          const pageCards = new Map<number, HTMLElement[]>();
          await Promise.all(
            neededPages.map(async (page) => {
              pageCards.set(page, await loadPage(page));
            })
          );
          if (token !== renderToken) return;

          const byId = new Map<string, HTMLElement>();
          for (const nodes of pageCards.values()) {
            for (const node of nodes) {
              const id = node.dataset.problemId;
              if (id) byId.set(id, node);
            }
          }

          cardsToShow = pageItems
            .map((item) => byId.get(item.id))
            .filter((node): node is HTMLElement => Boolean(node));
        } else {
          visibleCount = TOTAL;
          lastTotalPages = TOTAL_PAGES_ALL;
          currentPage = Math.max(1, Math.min(currentPage, lastTotalPages));
          cardsToShow = await loadPage(currentPage);
          if (token !== renderToken) return;
        }

        if (grid) {
          grid.replaceChildren(...cardsToShow);
          grid.toggleAttribute('hidden', visibleCount === 0);
        }

        if (countEl) countEl.textContent = String(visibleCount);
        if (emptyState) emptyState.toggleAttribute('hidden', visibleCount > 0);
        if (paginationBar) paginationBar.toggleAttribute('hidden', visibleCount === 0);
        if (curPageEl) curPageEl.textContent = String(currentPage);
        if (totalPagesEl) totalPagesEl.textContent = String(lastTotalPages);
        buildPagination(lastTotalPages);
        updateControls(visibleCount);
      } catch (error) {
        console.error('[problems] failed to render', error);
        if (token === renderToken && grid) {
          grid.removeAttribute('hidden');
          const message = document.createElement('p');
          message.className = 'col-span-full py-10 text-center text-sm text-slate-500';
          message.textContent = '문항을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.';
          grid.replaceChildren(message);
        }
      } finally {
        if (token === renderToken && grid) {
          grid.removeAttribute('aria-busy');
          grid.classList.remove('opacity-60');
        }
      }
    };

    const goPage = (page: number) => {
      currentPage = Math.max(1, Math.min(page, lastTotalPages));
      syncUrl();
      void render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    let searchTimer: number | undefined;
    searchInput?.addEventListener('input', () => {
      state.q = searchInput.value;
      currentPage = 1;
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        syncUrl();
        void render();
      }, 180);
    });

    clearBtn?.addEventListener('click', () => {
      state.q = '';
      currentPage = 1;
      if (searchInput) searchInput.value = '';
      syncUrl();
      void render();
      searchInput?.focus();
    });

    filterButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        state[btn.dataset.filter ?? ''] = btn.dataset.value ?? '';
        currentPage = 1;
        syncUrl();
        void render();
      })
    );

    resetButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        state.q = '';
        state.year = 'all';
        state.subject = '전체';
        currentPage = 1;
        if (searchInput) searchInput.value = '';
        syncUrl();
        void render();
      })
    );

    // 검색창/필터를 누르는 순간 인덱스를 미리 받아 첫 입력 지연을 줄입니다.
    // (초기 로드에서는 받지 않아 Core Web Vitals 측정에 영향을 주지 않습니다.)
    const prefetchIndex = () => {
      void loadIndex().catch(() => {});
    };
    searchInput?.addEventListener('focus', prefetchIndex, { once: true });
    searchInput?.addEventListener('pointerdown', prefetchIndex, { once: true });
    root.addEventListener('pointerdown', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-filter], [data-filter-reset]')) prefetchIndex();
    });

    // URL에 페이지/필터가 있으면 첫 화면 카드를 잠시 숨겨 잘못된 페이지가 보이지 않게 합니다.
    if (currentPage !== 1 || hasFilters()) {
      if (grid) grid.setAttribute('hidden', '');
    }

    void render();
  }
</script>
