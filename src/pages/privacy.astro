---
import BaseLayout from '../layouts/BaseLayout.astro';

const effectiveDate = '2026년 2월 24일';
const lastRevised = '2026년 10월 22일';
const version = '1.3';

const toc = [
  { href: '#purpose', label: '개인정보 처리 목적' },
  { href: '#items', label: '처리하는 개인정보 및 온라인 이용 정보' },
  { href: '#retention', label: '개인정보 처리 및 보유 기간' },
  { href: '#analytics', label: '쿠키 및 Google Analytics' },
  { href: '#ads', label: '광고와 제3자 광고 쿠키' },
  { href: '#cookie-control', label: '쿠키 사용의 거부' },
  { href: '#third-party', label: '개인정보 처리업무의 위탁 및 외부 서비스' },
  { href: '#external-links', label: '외부 링크' },
  { href: '#rights', label: '이용자의 권리와 행사 방법' },
  { href: '#security', label: '개인정보의 안전성 확보 조치' },
  { href: '#privacy-contact', label: '개인정보 보호 문의' },
  { href: '#changes', label: '개인정보처리방침의 변경' },
];

const purposes = [
  '웹사이트 방문 및 이용 현황의 통계 분석',
  '콘텐츠 품질과 사용자 경험 개선',
  '서비스 오류 및 비정상적인 접속 확인',
  '문의 및 오류 제보 접수와 답변',
  '광고 제공 및 광고 성과 측정',
];

const automaticData = [
  '쿠키 및 온라인 식별자',
  '방문 일시와 이용 페이지',
  '유입 경로',
  '브라우저, 운영체제 및 기기 유형',
  '대략적인 지역 정보',
  '페이지 조회, 스크롤 등 서비스 이용 기록',
  'IP 주소를 기반으로 처리되는 접속 정보',
  '오류 및 보안 로그',
];

const inquiryData = [
  '이메일 주소',
  '이름 또는 닉네임',
  '문의 및 오류 제보 내용',
  '이용자가 직접 첨부하거나 입력한 정보',
];

const retention = [
  { label: '문의 및 오류 제보 정보', value: '답변 완료 후 3개월' },
  { label: '웹사이트 접속 로그', value: '호스팅 또는 보안 서비스의 정책에 따른 기간' },
  { label: 'Google Analytics 데이터', value: 'HowLearn이 Google Analytics 관리 화면에서 설정한 보존 기간' },
  { label: 'Google Analytics 쿠키', value: '기본 설정 시 최대 2년' },
];

const rights = [
  '개인정보 처리 여부 확인 및 열람 요청',
  '개인정보 정정 또는 삭제 요청',
  '개인정보 처리정지 요청',
  '동의 철회',
  '쿠키와 맞춤형 광고 사용 거부',
];

const security = [
  '개인정보 접근 권한의 최소화',
  '관리자 계정 및 접근 수단 보호',
  'HTTPS를 통한 전송 구간 암호화',
  '호스팅 및 외부 서비스의 보안 설정 점검',
  '불필요한 개인정보의 수집 및 보관 최소화',
  '보유 기간이 지난 정보의 삭제',
];

const services = [
  {
    name: 'Google Analytics',
    purpose: '웹사이트 이용 통계 분석',
    note: '현재 사용',
  },
  {
    name: 'Google AdSense',
    purpose: '광고 제공 및 광고 성과 측정',
    note: '광고 게재가 시작된 경우에 한함',
  },
  {
    name: 'Cloudflare',
    purpose: '웹사이트 호스팅 및 접속 로그 관리',
    note: '',
  },
  {
    name: 'Formspree',
    purpose: '문의 및 오류 제보 접수',
    note: '문의 폼 접수',
  },
];
---

<BaseLayout
  title="개인정보처리방침 | HowLearn"
  description="HowLearn의 개인정보 처리 목적, 처리 항목, 보유 기간, 쿠키·Google Analytics·광고·외부 서비스, 이용자 권리 및 개인정보 보호 문의처를 안내합니다."
>
  <div class="max-w-4xl mx-auto space-y-8 sm:space-y-10">
    {/* Header */}
    <header class="border-b border-slate-200 pb-6">
      <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">LEGAL &amp; PRIVACY</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">
        개인정보처리방침
      </h1>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600">
        HowLearn은 이용자의 개인정보를 중요하게 생각하며, 관련 법령에 따라 개인정보가
        어떤 목적으로 어떻게 처리되는지 알리기 위해 본 개인정보처리방침을 공개합니다.
      </p>

      <div class="mt-4 flex flex-wrap gap-2 text-[11px] font-semibold text-slate-500">
        <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1">
          시행일 {effectiveDate}
        </span>
        <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1">
          최종 개정일 {lastRevised}
        </span>
        <span class="rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-indigo-700">
          버전 {version}
        </span>
      </div>
    </header>

    {/* Table of contents */}
    <nav class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs" aria-label="개인정보처리방침 목차">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">목차</h2>
      <ol class="mt-3 grid grid-cols-1 gap-x-6 gap-y-2 text-xs sm:grid-cols-2">
        {toc.map((item, index) => (
          <li>
            <a href={item.href} class="group flex items-start gap-2 text-slate-600 hover:text-indigo-700 transition-colors">
              <span class="w-5 shrink-0 font-bold text-slate-400 group-hover:text-indigo-500">{index + 1}.</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
      <div class="space-y-8 text-sm leading-relaxed text-slate-700">
        {/* 1 */}
        <section id="purpose" class="scroll-mt-24 border-t border-slate-100 pt-8 first:border-t-0 first:pt-0 space-y-3">
          <h2 class="flex items-center gap-2 text-base font-bold text-slate-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-[11px] font-extrabold text-indigo-700">1</span>
            개인정보 처리 목적
          </h2>
          <p>HowLearn은 다음 목적을 위해 필요한 범위에서 개인정보 또는 온라인 이용 정보를 처리할 수 있습니다.</p>
          <ul class="space-y-1.5 text-slate-600">
            {purposes.map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-400" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800">
            단, 광고 관련 처리는 Google AdSense 광고가 실제로 게재되는 시점부터 적용됩니다.
          </p>
          <p>
            HowLearn은 회원가입과 로그인 기능을 운영하지 않으며, 이름, 전화번호, 주소, 비밀번호 등의
            정보를 회원정보 형태로 직접 수집하지 않습니다.
          </p>
        </section>

        {/* 2 */}
        <section id="items" class="scroll-mt-24 border-t border-slate-100 pt-8 space-y-4">
          <h2 class="flex items-center gap-2 text-base font-bold text-slate-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-[11px] font-extrabold text-indigo-700">2</span>
            처리하는 개인정보 및 온라인 이용 정보
          </h2>

          <div class="space-y-2">
            <p>서비스 이용 과정에서 다음 정보가 자동으로 생성되거나 처리될 수 있습니다.</p>
            <ul class="grid gap-1.5 text-xs text-slate-600 sm:grid-cols-2">
              {automaticData.map((item) => (
                <li class="rounded-lg border border-slate-100 bg-slate-50 px-3 py-2">{item}</li>
              ))}
            </ul>
          </div>

          <div class="space-y-2">
            <p>문의 및 오류 제보 기능을 이용하는 경우 다음 정보가 처리될 수 있습니다.</p>
            <ul class="grid gap-1.5 text-xs text-slate-600 sm:grid-cols-2">
              {inquiryData.map((item) => (
                <li class="rounded-lg border border-slate-100 bg-slate-50 px-3 py-2">{item}</li>
              ))}
            </ul>
          </div>

          <p class="text-xs text-slate-500">
            이용자는 문의 내용에 불필요한 개인정보가 포함되지 않도록 주의해 주시기 바랍니다.
          </p>
        </section>

        {/* 3 */}
        <section id="retention" class="scroll-mt-24 border-t border-slate-100 pt-8 space-y-4">
          <h2 class="flex items-center gap-2 text-base font-bold text-slate-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-[11px] font-extrabold text-indigo-700">3</span>
            개인정보 처리 및 보유 기간
          </h2>
          <p>
            HowLearn은 개인정보를 처리 목적에 필요한 기간 동안만 보유하고, 목적 달성 후 지체 없이 파기합니다.
          </p>

          <dl class="overflow-hidden rounded-xl border border-slate-200 text-xs">
            {retention.map((item) => (
              <div class="grid gap-1 border-b border-slate-100 px-4 py-3 last:border-b-0 sm:grid-cols-[11rem_1fr] sm:gap-4">
                <dt class="font-semibold text-slate-700">{item.label}</dt>
                <dd class="text-slate-500">{item.value}</dd>
              </div>
            ))}
          </dl>

          <p class="text-xs text-slate-500">
            단, 이용자의 브라우저 정책, 쿠키 삭제 여부 및 HowLearn의 설정에 따라 달라질 수 있습니다.
            문의 및 오류 제보 정보는 외부 문의 서비스(Formspree)의 보관 정책에 따라 달라질 수 있습니다.
          </p>
          <p>
            관계 법령에 따라 일정 기간 보존할 필요가 있는 경우에는 해당 법령에서 정한 기간 동안 보관할 수 있습니다.
          </p>
        </section>

        {/* 4 */}
        <section id="analytics" class="scroll-mt-24 border-t border-slate-100 pt-8 space-y-4">
          <h2 class="flex items-center gap-2 text-base font-bold text-slate-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-[11px] font-extrabold text-indigo-700">4</span>
            쿠키 및 Google Analytics
          </h2>
          <p>
            HowLearn은 이용 현황을 분석하고 콘텐츠 및 사용자 경험을 개선하기 위해
            Google Analytics 4를 사용합니다. Google Analytics 4는 다음과 같은 쿠키를 사용할 수 있습니다.
          </p>

          <div class="grid gap-2 text-xs sm:grid-cols-2">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
              <code class="font-bold text-indigo-700">_ga</code>
              <p class="mt-1 text-slate-500">이용자를 구분하기 위해 사용</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
              <code class="font-bold text-indigo-700">_ga_&lt;컨테이너 ID&gt;</code>
              <p class="mt-1 text-slate-500">세션 상태를 유지하기 위해 사용</p>
            </div>
          </div>

          <p>
            해당 쿠키의 기본 만료 기간은 2년이며, 브라우저 정책과 사이트 설정에 따라 달라질 수 있습니다.
          </p>
          <p>
            Google Analytics를 통해 수집된 정보는 방문자 수, 자주 이용되는 페이지, 콘텐츠 이용 흐름 등을
            통계적으로 분석하는 데 사용됩니다. HowLearn은 Google Analytics에 이름, 이메일 주소, 전화번호 등
            이용자를 직접 식별할 수 있는 정보를 전송하지 않도록 운영합니다.
          </p>
          <p>
            Google의 정보 처리 방식에 관한 자세한 내용은{' '}
            <a
              href="https://policies.google.com/privacy?hl=ko"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-indigo-600 underline hover:text-indigo-800"
            >
              Google 개인정보처리방침
            </a>
            에서 확인할 수 있습니다.
          </p>
        </section>

        {/* 5 */}
        <section id="ads" class="scroll-mt-24 border-t border-slate-100 pt-8 space-y-4">
          <h2 class="flex items-center gap-2 text-base font-bold text-slate-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-[11px] font-extrabold text-indigo-700">5</span>
            광고와 제3자 광고 쿠키
          </h2>
          <p>HowLearn은 Google AdSense 승인을 받은 후 광고를 게재할 수 있습니다.</p>
          <p>
            광고 게재가 시작되면 Google을 포함한 제3자 광고 사업자가 광고 제공, 광고 성과 측정 및
            이용자에게 적합한 광고 제공을 위해 쿠키 또는 유사한 기술을 사용할 수 있습니다.
          </p>
          <p>
            제3자 광고 사업자는 이용자의 HowLearn 방문 기록 또는 다른 웹사이트 방문 기록을 바탕으로
            광고를 제공할 수 있습니다. Google의 광고 쿠키 사용을 통해 이용자의 관심사와 관련된
            맞춤형 광고가 표시될 수 있습니다.
          </p>
          <p>
            이용자는{' '}
            <a
              href="https://adssettings.google.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-indigo-600 underline hover:text-indigo-800"
            >
              Google 광고 설정
            </a>
            에서 맞춤형 광고 사용 여부를 관리할 수 있습니다. 맞춤형 광고를 거부하더라도 일반 광고는 표시될 수 있습니다.
          </p>
          <p class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800">
            이 조항은 Google AdSense 광고가 실제로 게재되는 시점부터 적용됩니다.
          </p>
        </section>

        {/* 6 */}
        <section id="cookie-control" class="scroll-mt-24 border-t border-slate-100 pt-8 space-y-4">
          <h2 class="flex items-center gap-2 text-base font-bold text-slate-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-[11px] font-extrabold text-indigo-700">6</span>
            쿠키 사용의 거부
          </h2>
          <p>
            이용자는 웹브라우저 설정을 통해 쿠키 저장을 허용하거나 차단할 수 있으며,
            이미 저장된 쿠키를 삭제할 수 있습니다.
          </p>
          <p>
            쿠키를 차단하더라도 HowLearn의 주요 교육 콘텐츠는 이용할 수 있습니다.
            다만 방문 분석, 사용자 설정 또는 광고 기능의 일부가 정상적으로 작동하지 않을 수 있습니다.
          </p>
          <p>이용자는 브라우저의 개인정보 보호 또는 쿠키 설정 메뉴에서 다음 조치를 할 수 있습니다.</p>
          <ul class="space-y-1.5 text-slate-600">
            {[
              '모든 쿠키 허용 또는 차단',
              '제3자 쿠키 차단',
              '사이트별 쿠키 설정',
              '저장된 쿠키 및 사이트 데이터 삭제',
            ].map((item) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-300" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        {/* 7 */}
        <section id="third-party" class="scroll-mt-24 border-t border-slate-100 pt-8 space-y-4">
          <h2 class="flex items-center gap-2 text-base font-bold text-slate-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-[11px] font-extrabold text-indigo-700">7</span>
            개인정보 처리업무의 위탁 및 외부 서비스
          </h2>
          <p>HowLearn은 서비스 운영을 위해 다음 외부 서비스를 이용할 수 있습니다.</p>

          <div class="overflow-hidden rounded-xl border border-slate-200 text-xs">
            {services.map((service) => (
              <div class="border-b border-slate-100 px-4 py-3 last:border-b-0">
                <div class="flex flex-wrap items-center gap-2">
                  <strong class="text-slate-800">{service.name}</strong>
                  {service.note && (
                    <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold text-slate-500">
                      {service.note}
                    </span>
                  )}
                </div>
                <p class="mt-1 text-slate-500">{service.purpose}</p>
              </div>
            ))}
          </div>

          <p>
            각 사업자는 해당 서비스 제공에 필요한 범위에서 정보를 처리할 수 있습니다.
            외부 서비스의 정보 처리에 대해서는 각 사업자의 개인정보처리방침이 함께 적용될 수 있습니다.
          </p>
          <p>
            국외 서버를 통해 정보가 처리되거나 이전되는 경우에는 관련 법령에 따라
