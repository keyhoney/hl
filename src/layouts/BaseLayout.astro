---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageType?: 'image/png' | 'image/jpeg';
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  twitterCard?: 'summary' | 'summary_large_image';
}

const {
  title = 'HowLearn | 수능 수학 다각도 해법',
  description = '한국 수능 수학 4점 킬러·준킬러 문항에 대해 정석 풀이, 스킬 숏컷, 단계별 힌트 등 다각도 해법과 분석을 제공하는 교육 플랫폼',
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageType = 'image/png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt = 'HowLearn 수능 수학 4점 기출 학습 아카이브',
  twitterCard = 'summary_large_image',
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = Astro.site ? new URL(currentPath, Astro.site).href : undefined;
const ogImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#4f46e5" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="HowLearn RSS 피드"
      href={new URL('/rss.xml', Astro.site ?? Astro.url).href}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="HowLearn" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content={twitterCard} />
    <!-- Pretendard web font for pristine Korean academic typography -->
    <!-- npm 패키지 CDN 사용: gh(GitHub) CDN의 CSS는 woff2 경로가 404라 폰트가 로드되지 않음 -->
    <!--
      - static(전체 웨이트) 대신 variable + dynamic subset을 사용해 폰트 전송량을 줄입니다.
      - media="print" → onload로 바꿔 초기 렌더링을 막지 않습니다. (font-display: swap)
    -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      crossorigin
      media="print"
      onload="this.media='all'"
      href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <noscript>
      <link
        rel="stylesheet"
        crossorigin
        href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      />
    </noscript>
    {/* Google Analytics 4 — 운영 빌드에서만 삽입합니다. */}
    {/*
      gtag.js(약 176 KiB)는 초기 렌더링과 대역폭을 두고 경쟁하지 않도록
      load 이벤트 이후에 비동기로 내려받습니다. pageview 큐는 그 전에 쌓아 둡니다.
    */}
    {import.meta.env.PROD && (
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', 'G-FMQ8NK63M3');
        window.addEventListener(
          'load',
          function () {
            var script = document.createElement('script');
            script.async = true;
            script.src = 'https://www.googletagmanager.com/gtag/js?id=G-FMQ8NK63M3';
            document.head.appendChild(script);
          },
          { once: true }
        );
      </script>
    )}

    {/* Google AdSense 로더 — PUBLIC_ADSENSE_CLIENT 설정 시에만 삽입됩니다. */}
    {import.meta.env.PUBLIC_ADSENSE_CLIENT && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <div class="min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-indigo-100 selection:text-indigo-900">
      <Header currentPath={currentPath} />
      <main class="grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
